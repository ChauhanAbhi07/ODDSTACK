NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=hello@oddestack.com
# Development defaults to preview; production defaults to public.
# CONTENT_MODE=preview
# Local persistence is supported only outside production, unless explicitly allowed for local production testing.
INQUIRY_STORAGE_DRIVER=local
# ALLOW_LOCAL_INQUIRIES=true
# INQUIRY_LOCAL_PATH=.local/inquiries
# Production webhook must persist durably, enforce shared rate limits and honor Idempotency-Key.
# INQUIRY_WEBHOOK_URL=https://your-service.example/inquiries
# INQUIRY_WEBHOOK_SECRET=
# Enable only behind a trusted proxy that replaces incoming forwarded headers.
# TRUST_PROXY=true

# Durable PostgreSQL storage (use INQUIRY_STORAGE_DRIVER=postgres).
# DATABASE_URL=postgresql://user:password@hostname:5432/oddestack?sslmode=verify-full
# RATE_LIMIT_SECRET=
# Optional delivery after durable storage. Receiver must deduplicate by Idempotency-Key.
# INQUIRY_NOTIFICATION_WEBHOOK_URL=https://your-service.example/notifications
# INQUIRY_NOTIFICATION_WEBHOOK_SECRET=
# Set a business-approved retention period before using db:retention -- --apply.
# INQUIRY_RETENTION_DAYS=
# Set these only once the corresponding work has actually been completed.
# CONTACT_EMAIL_CONFIRMED=true
# BUSINESS_CONTENT_REVIEWED=true
# LEGAL_PAGES_REVIEWED=true
